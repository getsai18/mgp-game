{
  "name": "arena-caos",
  "version": "1.0.0",
  "description": "Arena Caos: duelo 1vs1 multijugador en tiempo real (Phaser + socket.io, servidor autoritativo)",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"node --watch server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
